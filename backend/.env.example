# ═══════════════════════════════════════════════════════════════════════════
# .env.example — Variables de entorno requeridas para ejecutar el backend
# Copiar a .env y llenar con valores reales. NUNCA commitear .env
# ═══════════════════════════════════════════════════════════════════════════

# ── Django ────────────────────────────────────────────────────────────────
SECRET_KEY=<generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())">
DEBUG=True

# ── Base de datos (PostgreSQL en producción, SQLite en dev) ───────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Cifrado de campos sensibles (Fernet) ──────────────────────────────────
FIELD_ENCRYPTION_KEY=<generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">

# ── Cloudinary (almacenamiento de imágenes) ───────────────────────────────
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── Email (SMTP o Resend) ─────────────────────────────────────────────────
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@tudominio.com
RESEND_API_KEY=

# ── Wompi (pagos — configuración global) ──────────────────────────────────
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_KEY=
WOMPI_EVENTS_SECRET=

# ── Google OAuth ──────────────────────────────────────────────────────────
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# ── Frontend URL (para redirecciones de pago y emails) ────────────────────
FRONTEND_URL=https://tu-app.vercel.app
